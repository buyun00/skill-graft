#!/bin/sh

phase="$1"
if [ "$phase" != "committed" ]; then
    cat >/dev/null
    exit 0
fi

enabled="$(git config --get --bool ozdqp.skillWatchEnabled 2>/dev/null)"
if [ "$enabled" != "true" ]; then
    cat >/dev/null
    exit 0
fi

hub="$(git config --get ozdqp.skillWatchWorkspace 2>/dev/null)"
if [ -z "$hub" ]; then
    cat >/dev/null
    exit 0
fi

game="$(git rev-parse --show-toplevel 2>/dev/null)"
cli="${hub%/}/dist/control/cli.js"
if [ ! -f "$cli" ] || [ -z "$game" ]; then
    cat >/dev/null
    exit 0
fi

payload="$(cat)"
if [ -z "$payload" ]; then
    exit 0
fi

printf '%s\n' "$payload" | HUB_ROOT="$hub" node "$cli" ingest --game-repo "$game" --dispatch
status=$?
if [ $status -ne 0 ]; then
    echo "[OZDQP Skill Hub] ingest failed (exit $status); git operation continues." >&2
fi
exit 0

