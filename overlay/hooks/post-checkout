#!/bin/sh

game="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$game" ]; then
    exit 0
fi

hook_name="post-checkout"

valid_diagnostic_file() {
    file="$1"
    name="${file##*/}"
    printf '%s\n' "$name" | grep -Eq '^diag-[0-9]{13}-[a-f0-9]{16}\.json$' || return 1
    [ -f "$file" ] && [ ! -L "$file" ] || return 1
    bytes="$(wc -c < "$file" 2>/dev/null | tr -d ' ')"
    lines="$(wc -l < "$file" 2>/dev/null | tr -d ' ')"
    case "$bytes:$lines" in
        ''|*[^0-9:]*|*:0) return 1 ;;
    esac
    [ "$bytes" -le 1024 ] && [ "$lines" -eq 1 ] || return 1
    grep -Eq '^\{"schema":"skill-graft\.hook-diagnostic\.v1","schemaVersion":1,"at":"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z","hook":"(post-checkout|reference-transaction)","phase":"(launch|command)","code":"(NODE_UNAVAILABLE|CLI_MISSING|COMMAND_FAILED)","exitCode":(null|[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]),"requestIdHash":(null|"sha256:[a-f0-9]{64}")\}$' "$file" \
        && grep -Eq '"phase":"launch","code":"(NODE_UNAVAILABLE|CLI_MISSING)","exitCode":null|"phase":"command","code":"COMMAND_FAILED","exitCode":([1-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])' "$file"
}

record_hook_diagnostic() {
    phase="$1"
    code="$2"
    raw_exit="$3"
    case "$phase:$code" in
        launch:NODE_UNAVAILABLE|launch:CLI_MISSING|command:COMMAND_FAILED) ;;
        *) return 1 ;;
    esac
    exit_json="null"
    case "$raw_exit" in
        ''|*[!0-9]*) ;;
        *) if [ "$raw_exit" -le 255 ] 2>/dev/null; then exit_json="$raw_exit"; fi ;;
    esac

    admin="$(git -C "$game" rev-parse --absolute-git-dir 2>/dev/null)" || return 1
    diagnostics="$(git -C "$game" rev-parse --path-format=absolute --git-path skill-graft/hook-diagnostics-v1 2>/dev/null)" || return 1
    admin="$(printf '%s' "$admin" | tr '\\' '/' | sed 's:/*$::')"
    diagnostics="$(printf '%s' "$diagnostics" | tr '\\' '/' | sed 's:/*$::')"
    case "$diagnostics" in
        "$admin"/skill-graft/hook-diagnostics-v1) ;;
        *) return 1 ;;
    esac

    physical_admin="$(cd -P "$admin" 2>/dev/null && pwd -P)" || return 1
    product_dir="$admin/skill-graft"
    diagnostics_dir="$product_dir/hook-diagnostics-v1"
    if [ -L "$product_dir" ] || { [ -e "$product_dir" ] && [ ! -d "$product_dir" ]; }; then return 1; fi
    if [ ! -d "$product_dir" ]; then mkdir "$product_dir" 2>/dev/null || return 1; fi
    physical_product="$(cd -P "$product_dir" 2>/dev/null && pwd -P)" || return 1
    [ "$physical_product" = "$physical_admin/skill-graft" ] || return 1
    if [ -L "$diagnostics_dir" ] || { [ -e "$diagnostics_dir" ] && [ ! -d "$diagnostics_dir" ]; }; then return 1; fi
    if [ ! -d "$diagnostics_dir" ]; then mkdir "$diagnostics_dir" 2>/dev/null || return 1; fi
    physical_diagnostics="$(cd -P "$diagnostics_dir" 2>/dev/null && pwd -P)" || return 1
    [ "$physical_diagnostics" = "$physical_product/hook-diagnostics-v1" ] || return 1

    count=0
    total=0
    for entry in "$physical_diagnostics"/* "$physical_diagnostics"/.[!.]* "$physical_diagnostics"/..?*; do
        if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then continue; fi
        valid_diagnostic_file "$entry" || return 1
        entry_bytes="$(wc -c < "$entry" 2>/dev/null | tr -d ' ')"
        count=$((count + 1))
        total=$((total + entry_bytes))
    done

    at="$(date -u '+%Y-%m-%dT%H:%M:%S.000Z' 2>/dev/null)" || return 1
    seconds="$(date -u '+%s' 2>/dev/null)" || return 1
    stamp="${seconds}000"
    printf '%s\n' "$stamp" | grep -Eq '^[0-9]{13}$' || return 1
    nonce="$(printf '%s' "$hook_name:$phase:$code:$stamp:$$" | git hash-object --stdin 2>/dev/null | cut -c1-16)"
    printf '%s\n' "$nonce" | grep -Eq '^[a-f0-9]{16}$' || return 1
    payload="{\"schema\":\"skill-graft.hook-diagnostic.v1\",\"schemaVersion\":1,\"at\":\"$at\",\"hook\":\"$hook_name\",\"phase\":\"$phase\",\"code\":\"$code\",\"exitCode\":$exit_json,\"requestIdHash\":null}"
    payload_bytes="$(printf '%s\n' "$payload" | wc -c | tr -d ' ')"
    [ "$payload_bytes" -le 1024 ] || return 1

    set -- "$physical_diagnostics"/diag-*.json
    if [ "$#" -eq 1 ] && [ ! -e "$1" ]; then set --; fi
    [ "$#" -eq "$count" ] || return 1
    while [ "$count" -ge 32 ] || [ $((total + payload_bytes)) -gt 65536 ]; do
        oldest="$1"
        valid_diagnostic_file "$oldest" || return 1
        oldest_bytes="$(wc -c < "$oldest" 2>/dev/null | tr -d ' ')"
        rm -- "$oldest" 2>/dev/null || return 1
        shift
        count=$((count - 1))
        total=$((total - oldest_bytes))
    done

    final="$physical_diagnostics/diag-$stamp-$nonce.json"
    [ ! -e "$final" ] && [ ! -L "$final" ] || return 1
    (umask 077; set -C; printf '%s\n' "$payload" > "$final") 2>/dev/null || return 1
}

run_hook_command() {
    request_id="$1"
    shift
    SKILL_GRAFT_HOME="$data_root" HUB_ROOT="$data_root" node "$cli" "$@" --contract-v1 --request-id "$request_id" >/dev/null 2>&1
    status=$?
    if [ "$status" -ne 0 ]; then
        SKILL_GRAFT_HOME="$data_root" HUB_ROOT="$data_root" node "$cli" hook-diagnostic \
            --worktree "$game" --hook "$hook_name" --phase command --code COMMAND_FAILED \
            --exit-code "$status" --request-id "$request_id" >/dev/null 2>&1 \
            || record_hook_diagnostic command COMMAND_FAILED "$status"
    fi
}

hub="$(git -C "$game" config --get ozdqp.localOverlaySource 2>/dev/null)"
if [ -z "$hub" ]; then
    exit 0
fi
hub="$(printf '%s' "$hub" | tr '\\\\' '/')"
case "$hub" in
    /*|[A-Za-z]:/*) ;;
    *) exit 0 ;;
esac

cli="${hub%/}/dist/control/cli.js"
if ! command -v node >/dev/null 2>&1; then
    record_hook_diagnostic launch NODE_UNAVAILABLE ""
    exit 0
fi
if [ ! -f "$cli" ]; then
    record_hook_diagnostic launch CLI_MISSING ""
    exit 0
fi

auto="$(git config --get --bool ozdqp.skillHubAutoAttach 2>/dev/null)"
primary_root="$(printf '%s' "${SKILL_GRAFT_HOME:-}" | tr '\\\\' '/')"
legacy_root="$(printf '%s' "${HUB_ROOT:-}" | tr '\\\\' '/')"
if [ -n "$primary_root" ] && [ -n "$legacy_root" ] && [ "${primary_root%/}" != "${legacy_root%/}" ]; then
    exit 0
fi
data_root="${primary_root:-$legacy_root}"
if [ -z "$data_root" ]; then
    data_root="$(git -C "$game" config --get ozdqp.skillWatchWorkspace 2>/dev/null)"
fi
data_root="$(printf '%s' "$data_root" | tr '\\\\' '/')"
case "$data_root" in
    /*|[A-Za-z]:/*) ;;
    *) exit 0 ;;
esac
list="${data_root%/}/overlay/do-not-auto-attach.txt"
attached="${data_root%/}/overlay/attached-worktrees.txt"

if grep -Fqx "$game" "$list" 2>/dev/null; then
    exit 0
fi

if grep -Fqx "$game" "$attached" 2>/dev/null; then
    request_id="hook-post-checkout-repair-$(date -u '+%s' 2>/dev/null)-$$"
    run_hook_command "$request_id" repair-links --worktree "$game"
    exit 0
fi

if [ "$auto" != "true" ]; then
    exit 0
fi

echo "[OZDQP Skill Hub] new worktree detected; launching Codex attach session (no silent strip)."
request_id="hook-post-checkout-attach-$(date -u '+%s' 2>/dev/null)-$$"
run_hook_command "$request_id" attach --worktree "$game"
exit 0
