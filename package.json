{
  "name": "ozdqp-skill-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "sg": "dist/control/cli.js",
    "ozdqp-hub": "dist/control/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "npm run build && node dist/control/cli.js setup",
    "hub": "node dist/control/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:adapter": "npm run build && node --test test/adapter.test.mjs",
    "test:core": "npm run build && node --test test/core.test.mjs",
    "test:cli": "npm run build && node --test test/cli.test.mjs",
    "test:http": "npm run build && node --test test/http.test.mjs",
    "api": "node server/index.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.7.2"
  }
}
